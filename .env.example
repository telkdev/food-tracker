DATABASE_URL=postgres://postgres:postgres@localhost:5432/food_tracker
# 32+ random chars; Nuxt appSecret, seals the session cookie
NUXT_APP_SECRET=change-me-to-a-long-random-string-32chars
# login password for the single user, 12+ chars
NUXT_APP_PASSWORD=change-me-please  # no "$": Render collapses "$$" to "$"
# public origin used in OAuth metadata (falls back to RENDER_EXTERNAL_URL, then the request)
NUXT_SITE_URL=http://localhost:3000
# Open Food Facts: contact email for the User-Agent; for development use the staging server
NUXT_OFF_CONTACT=you@example.com
# NUXT_OFF_BASE_URL=https://world.openfoodfacts.net
# NUXT_OFF_BASIC_AUTH=off:off
